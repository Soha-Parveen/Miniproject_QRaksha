# ========================================================
# QRaksha - Environment Configuration Template
# DO NOT COMMIT REAL SECRETS OR SENSITIVE API KEYS TO GIT
# ========================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Application Defaults
DEFAULT_HIGH_VALUE_THRESHOLD=50000
DEFAULT_WALLET_INITIAL_BALANCE=10000

# SMS Provider (Optional - For Production OTP recovery)
# Options: DEV_MODE | MSG91 | FAST2SMS | TWILIO
SMS_PROVIDER=DEV_MODE
SMS_API_KEY=your_sms_provider_api_key_here
SMS_SENDER_ID=QRAKSH

# Mobile Client API Base URL (Point to your computer's local Wi-Fi IP when testing on a physical Android phone)
# Example: http://192.168.1.5:5000
EXPO_PUBLIC_API_URL=http://localhost:5000

